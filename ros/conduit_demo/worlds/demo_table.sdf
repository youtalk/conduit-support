<?xml version="1.0"?>
<!--
  The Conduit Robots demo arm's world: the Panda (spawned at the origin, on the table
  top) with three 4.5 cm cubes (red, green, blue) and a tray in reach.

  Light setting: no shadows, one directional light, plain colors, so the wrist camera
  renders in software (Mesa llvmpipe) without a GPU. The physics step is 1 ms at a
  real-time factor of 1.
-->
<sdf version="1.10">
  <world name="demo_table">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.78 0.82 0.86 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The table: top surface at z = 0 (the Panda's base), 1.0 x 1.2 m, legs to the floor. -->
    <model name="table">
      <static>true</static>
      <pose>0.3 0 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 -0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>1.0 1.2 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 -0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>1.0 1.2 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.6 0.45 1</ambient>
            <diffuse>0.72 0.6 0.45 1</diffuse>
          </material>
        </visual>
        <visual name="leg_front_left">
          <pose>0.45 0.55 -0.395 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.71</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="leg_front_right">
          <pose>0.45 -0.55 -0.395 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.71</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="leg_back_left">
          <pose>-0.45 0.55 -0.395 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.71</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="leg_back_right">
          <pose>-0.45 -0.55 -0.395 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.71</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cubes: 4.5 cm, 50 g (inertia m a^2 / 6). -->
    <model name="red_cube">
      <pose>0.5 -0.12 0.0225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx>
            <iyy>1.6875e-05</iyy>
            <izz>1.6875e-05</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.045 0.045 0.045</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.045 0.045 0.045</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient>
            <diffuse>0.85 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="green_cube">
      <pose>0.5 0 0.0225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx>
            <iyy>1.6875e-05</iyy>
            <izz>1.6875e-05</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.045 0.045 0.045</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.045 0.045 0.045</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.15 1</ambient>
            <diffuse>0.1 0.7 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <pose>0.5 0.12 0.0225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx>
            <iyy>1.6875e-05</iyy>
            <izz>1.6875e-05</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.045 0.045 0.045</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.045 0.045 0.045</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.25 0.85 1</ambient>
            <diffuse>0.1 0.25 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tray: 20 x 20 cm inside, 3 cm walls, beside the cubes. -->
    <model name="tray">
      <static>true</static>
      <pose>0.35 0.38 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom_collision">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.22 0.22 0.005</size>
            </box>
          </geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.22 0.22 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.2 1</ambient>
            <diffuse>0.95 0.75 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="wall_px_collision">
          <pose>0.105 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.22 0.03</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_px_visual">
          <pose>0.105 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.22 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.2 1</ambient>
            <diffuse>0.95 0.75 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="wall_nx_collision">
          <pose>-0.105 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.22 0.03</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_nx_visual">
          <pose>-0.105 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.22 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.2 1</ambient>
            <diffuse>0.95 0.75 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="wall_py_collision">
          <pose>0 0.105 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 0.01 0.03</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_py_visual">
          <pose>0 0.105 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 0.01 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.2 1</ambient>
            <diffuse>0.95 0.75 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="wall_ny_collision">
          <pose>0 -0.105 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 0.01 0.03</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_ny_visual">
          <pose>0 -0.105 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 0.01 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.2 1</ambient>
            <diffuse>0.95 0.75 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
